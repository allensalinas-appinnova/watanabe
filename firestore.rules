rules_version = '2';

// Prototype production rules for the canonical mobile model. Review before
// deploying to a live Firebase project.
// Collections: categoryCatalog, users/{uid}/accounts, categories, operations,
// operations/{operationId}/entries, ledgerEntries, budgets/items and
// monthlySummaries.
// Coach: optional users/{uid}.coachPreferences is an exact eight-field map
// (booleans, integer local times, unique ISO weekdays). Optional Home widget
// coachNextStep is boolean; legacy widget keys remain required.
// coachDailyCheckIns/{YYYY-MM-DD} and coachWeeklyReviews/{YYYY-MM-DD}:
// exact periodKey (document ID), kind (daily/weekly), noMovements (boolean,
// false for weekly), reviewedAt (server timestamp). Owner reads/writes only;
// writes require an existing profile, deletes are forbidden.
// Email import candidates (including evidence), credentials, command receipts
// and source/reference deduplication markers are server-only. The future client
// must use callable responses so email evidence never enters persistent cache.
// Debt accounts (nature=debt), debtCommands, debtReversals and debtRefunds are
// server-owned. Only mutateDebt may change balances, components or source ops.
// Admin portal: adminOperators, adminDailyMetrics and adminAudit are server-only.
// Admin reads are made through authenticated, allowlisted callable DTOs; device
// records may optionally include appVersion/buildNumber (legacy values omitted).

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function owner(uid) { return authenticated() && request.auth.uid == uid; }
    function profileGeneration(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('dataGeneration', 0);
    }
    function profileWritable(uid) {
      return owner(uid) && exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('resetStatus', 'ready') == 'ready' &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('operationProjectionMigration', 'idle') != 'running';
    }
    function generationMatches(uid, data) {
      return profileWritable(uid) && data.get('dataGeneration', 0) == profileGeneration(uid);
    }
    function validCurrency(value) {
      return value is string && value.matches('^[A-Z]{3}$');
    }
    function validMonthKey(value) {
      return value is string && value.matches('^\\d{4}-(0[1-9]|1[0-2])$');
    }
    function validIdempotencyKey(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{8,128}$');
    }
    function maxMinorUnits(currency) {
      return currency in ['CLP', 'COP', 'JPY', 'KRW', 'PYG'] ? 1000000000 : 100000000000;
    }
    function validMoney(value, currency) {
      return value is int && value > 0 && value <= maxMinorUnits(currency);
    }
    function validNonNegativeMoney(value, currency) {
      return value is int && value >= 0 && value <= maxMinorUnits(currency);
    }
    function required(data, fields) { return data.keys().hasAll(fields); }
    function accountExists(uid, accountId, currency) {
      return accountId is string &&
        exists(/databases/$(database)/documents/users/$(uid)/accounts/$(accountId)) &&
        get(/databases/$(database)/documents/users/$(uid)/accounts/$(accountId)).data.get('nature', 'money') == 'money' &&
        get(/databases/$(database)/documents/users/$(uid)/accounts/$(accountId)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(uid)/accounts/$(accountId)).data.currency == currency;
    }
    function categoryExists(uid, categoryId, type) {
      return categoryId is string &&
        exists(/databases/$(database)/documents/users/$(uid)/categories/$(categoryId)) &&
        get(/databases/$(database)/documents/users/$(uid)/categories/$(categoryId)).data.type == type;
    }
    function validBudgetItemLink(uid, data) {
      return (!('budgetId' in data) && !('budgetItemId' in data)) ||
        (('budgetId' in data) && ('budgetItemId' in data) &&
          data.budgetId is string && data.budgetId.size() > 0 &&
          data.budgetItemId is string && data.budgetItemId.size() > 0 &&
          data.type in ['income', 'expense'] && data.categoryId is string &&
          exists(/databases/$(database)/documents/users/$(uid)/budgets/$(data.budgetId)) &&
          exists(/databases/$(database)/documents/users/$(uid)/budgets/$(data.budgetId)/items/$(data.budgetItemId)) &&
          get(/databases/$(database)/documents/users/$(uid)/budgets/$(data.budgetId)).data.categoryId == data.categoryId &&
          get(/databases/$(database)/documents/users/$(uid)/budgets/$(data.budgetId)).data.flowType == data.type &&
          get(/databases/$(database)/documents/users/$(uid)/budgets/$(data.budgetId)).data.currency == data.currency);
    }
    function validOperation(data) {
      return required(data, ['type', 'amountMinor', 'currency', 'monthKey', 'occurredAt', 'description', 'status', 'idempotencyKey', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'type', 'amountMinor', 'currency', 'categoryId', 'accountId',
          'sourceAccountId', 'destinationAccountId', 'budgetId', 'budgetItemId', 'monthKey', 'occurredAt',
          'description', 'status', 'idempotencyKey', 'createdAt', 'updatedAt', 'dataGeneration'
        ]) &&
        data.type in ['income', 'expense', 'transfer'] &&
        validCurrency(data.currency) && validMoney(data.amountMinor, data.currency) &&
        validMonthKey(data.monthKey) && data.occurredAt is timestamp &&
        data.description is string && data.description.size() <= 500 &&
        data.status == 'confirmed' && validIdempotencyKey(data.idempotencyKey);
    }
    function validCategoryColor(data) {
      return !('colorValue' in data) ||
        (data.colorValue is int && data.colorValue >= 0 && data.colorValue <= 4294967295);
    }
    function validHomePreferences(data) {
      return !('homePreferences' in data) ||
        (data.homePreferences is map &&
          data.homePreferences.keys().hasOnly(['widgets', 'hiddenBudgetCategoryIds']) &&
          required(data.homePreferences, ['widgets', 'hiddenBudgetCategoryIds']) &&
          data.homePreferences.widgets is map &&
          data.homePreferences.widgets.keys().hasOnly([
            'totalBalance', 'incomeSummary', 'expenseSummary',
            'expenseBudgetRatio', 'incomeBudgetRatio', 'recentActivity', 'coachNextStep', 'debtCommitments'
          ]) &&
          required(data.homePreferences.widgets, [
            'totalBalance', 'incomeSummary', 'expenseSummary',
            'expenseBudgetRatio', 'incomeBudgetRatio', 'recentActivity'
          ]) &&
          data.homePreferences.widgets.totalBalance is bool &&
          data.homePreferences.widgets.incomeSummary is bool &&
          data.homePreferences.widgets.expenseSummary is bool &&
          data.homePreferences.widgets.expenseBudgetRatio is bool &&
          data.homePreferences.widgets.incomeBudgetRatio is bool &&
          data.homePreferences.widgets.recentActivity is bool &&
          (!('coachNextStep' in data.homePreferences.widgets) ||
            data.homePreferences.widgets.coachNextStep is bool) &&
          (!('debtCommitments' in data.homePreferences.widgets) ||
            data.homePreferences.widgets.debtCommitments is bool) &&
          data.homePreferences.hiddenBudgetCategoryIds is list &&
          data.homePreferences.hiddenBudgetCategoryIds.size() <= 100 &&
          data.homePreferences.hiddenBudgetCategoryIds.toSet().size() ==
            data.homePreferences.hiddenBudgetCategoryIds.size());
    }
    function validAppearancePreferences(data) {
      return !('appearancePreferences' in data) ||
        (data.appearancePreferences is map &&
          data.appearancePreferences.keys().hasOnly(['mode', 'palette']) &&
          required(data.appearancePreferences, ['mode', 'palette']) &&
          data.appearancePreferences.mode in ['system', 'light', 'dark'] &&
          data.appearancePreferences.palette in ['lumio', 'classicBlue', 'ocean', 'plum']);
    }

    // Administrative collections are never directly accessible to app clients.
    // All portal reads go through Functions, which verifies an active operator.
    match /adminOperators/{path=**} { allow read, write: if false; }
    match /adminDailyMetrics/{path=**} { allow read, write: if false; }
    match /adminAudit/{path=**} { allow read, write: if false; }

    function validCoachHour(value) {
      return value is int && value >= 0 && value <= 23;
    }
    function validCoachMinute(value) {
      return value is int && value >= 0 && value <= 59;
    }
    function validCoachWeekday(value) {
      return value is int && value >= 1 && value <= 7;
    }
    function validCoachWeekdays(days) {
      return days is list && days.size() >= 1 && days.size() <= 7 &&
        days.toSet().size() == days.size() &&
        validCoachWeekday(days[0]) &&
        (days.size() < 2 || validCoachWeekday(days[1])) &&
        (days.size() < 3 || validCoachWeekday(days[2])) &&
        (days.size() < 4 || validCoachWeekday(days[3])) &&
        (days.size() < 5 || validCoachWeekday(days[4])) &&
        (days.size() < 6 || validCoachWeekday(days[5])) &&
        (days.size() < 7 || validCoachWeekday(days[6]));
    }
    function validCoachPreferences(data) {
      let fields = ['dailyEnabled', 'weeklyEnabled', 'dailyHour', 'dailyMinute',
        'dailyWeekdays', 'weeklyWeekday', 'weeklyHour', 'weeklyMinute'];
      return !('coachPreferences' in data) ||
        (data.coachPreferences is map &&
          data.coachPreferences.keys().hasOnly(fields) &&
          required(data.coachPreferences, fields) &&
          data.coachPreferences.dailyEnabled is bool &&
          data.coachPreferences.weeklyEnabled is bool &&
          validCoachHour(data.coachPreferences.dailyHour) &&
          validCoachMinute(data.coachPreferences.dailyMinute) &&
          validCoachWeekdays(data.coachPreferences.dailyWeekdays) &&
          validCoachWeekday(data.coachPreferences.weeklyWeekday) &&
          validCoachHour(data.coachPreferences.weeklyHour) &&
          validCoachMinute(data.coachPreferences.weeklyMinute));
    }
    function validCoachCompletion(data, periodKey, kind) {
      return required(data, ['periodKey', 'kind', 'noMovements', 'reviewedAt']) &&
        data.keys().hasOnly(['periodKey', 'kind', 'noMovements', 'reviewedAt', 'dataGeneration']) &&
        data.periodKey is string && data.periodKey == periodKey &&
        data.periodKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        data.kind == kind && data.noMovements is bool &&
        (kind == 'daily' || data.noMovements == false) &&
        data.reviewedAt is timestamp && data.reviewedAt == request.time;
    }

    match /categoryCatalog/{categoryId} {
      allow read: if authenticated();
      allow write: if false;
    }

    match /users/{uid} {
      match /emailImportCandidates/{id} { allow read, write: if false; }
      match /emailImportCredentials/{id} { allow read, write: if false; }
      match /emailImportCommands/{id} { allow read, write: if false; }
      match /emailImportSources/{id} { allow read, write: if false; }
      match /emailImportReferences/{id} { allow read, write: if false; }
      match /debtCommitmentCommands/{id} { allow read, write: if false; }
      match /debtCommitments/{commitmentId} {
        allow read: if owner(uid);
        allow write: if false;
        match /versions/{versionId} { allow read: if owner(uid); allow write: if false; }
        match /occurrences/{occurrenceId} { allow read: if owner(uid); allow write: if false; }
      }
      match /debtPayments/{paymentId} { allow read: if owner(uid); allow write: if false; }
      match /debtPaymentLinks/{paymentId} { allow read: if owner(uid); allow write: if false; }
      // Installation metadata is readable by its owner and mutated only by manageDevice.
      match /devices/{installationId} { allow read: if owner(uid); allow write: if false; }
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly([
        'locale', 'countryCode', 'timeZone', 'defaultCurrency',
        'onboardingStatus', 'categoryCatalogVersion', 'createdAt', 'updatedAt', 'coachPreferences',
        'appearancePreferences', 'dataGeneration'
      ]) && required(request.resource.data, ['locale', 'countryCode', 'timeZone', 'defaultCurrency', 'onboardingStatus', 'categoryCatalogVersion', 'createdAt', 'updatedAt']) &&
        request.resource.data.get('dataGeneration', 0) == 0 &&
        validCoachPreferences(request.resource.data) && validAppearancePreferences(request.resource.data);
      allow update: if owner(uid) && resource.data.get('resetStatus', 'ready') == 'ready' && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'locale', 'countryCode', 'timeZone', 'defaultCurrency',
        'onboardingStatus', 'categoryCatalogVersion', 'homePreferences', 'coachPreferences',
        'appearancePreferences', 'updatedAt', 'dataGeneration'
      ]) && validHomePreferences(request.resource.data) && validCoachPreferences(request.resource.data) &&
        validAppearancePreferences(request.resource.data) &&
        request.resource.data.get('dataGeneration', 0) == resource.data.get('dataGeneration', 0);
      allow delete: if false;

      match /coachDailyCheckIns/{periodKey} {
        allow read: if owner(uid);
        allow create, update: if generationMatches(uid, request.resource.data) &&
          exists(/databases/$(database)/documents/users/$(uid)) &&
          validCoachCompletion(request.resource.data, periodKey, 'daily');
        allow delete: if false;
      }

      match /coachWeeklyReviews/{periodKey} {
        allow read: if owner(uid);
        allow create, update: if generationMatches(uid, request.resource.data) &&
          exists(/databases/$(database)/documents/users/$(uid)) &&
          validCoachCompletion(request.resource.data, periodKey, 'weekly');
        allow delete: if false;
      }

      match /accounts/{accountId} {
        allow read: if owner(uid);
        allow create: if generationMatches(uid, request.resource.data) && request.resource.data.keys().hasOnly([
          'name', 'type', 'currency', 'openingBalanceMinor', 'currentBalanceMinor',
          'includeInDashboard', 'status', 'createdAt', 'updatedAt', 'archivedAt', 'nature', 'dataGeneration'
        ]) && required(request.resource.data, ['name', 'type', 'currency', 'openingBalanceMinor', 'currentBalanceMinor', 'includeInDashboard', 'status', 'createdAt', 'updatedAt']) &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          request.resource.data.get('nature', 'money') == 'money' &&
          !(request.resource.data.type in ['creditCard', 'bankLoan', 'personalLoan']) &&
          validCurrency(request.resource.data.currency) &&
          request.resource.data.openingBalanceMinor is int &&
          request.resource.data.currentBalanceMinor is int &&
          validNonNegativeMoney(request.resource.data.openingBalanceMinor, request.resource.data.currency) &&
          validNonNegativeMoney(request.resource.data.currentBalanceMinor, request.resource.data.currency) &&
          request.resource.data.currentBalanceMinor == request.resource.data.openingBalanceMinor &&
          request.resource.data.status in ['active', 'archived'];
        allow update: if profileWritable(uid) && resource.data.get('nature', 'money') == 'money' && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'includeInDashboard', 'updatedAt'
        ]) && (!('includeInDashboard' in request.resource.data) ||
          request.resource.data.includeInDashboard is bool);
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if owner(uid);
        allow create: if generationMatches(uid, request.resource.data) && request.resource.data.keys().hasOnly([
          'catalogId', 'type', 'name', 'icon', 'colorValue', 'sortOrder',
          'isSystem', 'isArchived', 'createdAt', 'updatedAt', 'dataGeneration'
        ]) && required(request.resource.data, ['type', 'name', 'icon', 'sortOrder', 'isSystem', 'isArchived', 'createdAt', 'updatedAt']) && request.resource.data.type in ['income', 'expense'] &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          validCategoryColor(request.resource.data) &&
          (!request.resource.data.isSystem ||
            exists(/databases/$(database)/documents/categoryCatalog/$(request.resource.data.catalogId)));
        allow update: if profileWritable(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'icon', 'colorValue', 'sortOrder', 'isArchived', 'updatedAt'
        ]) && validCategoryColor(request.resource.data);
        allow delete: if false;
      }

      match /operations/{operationId} {
        allow read: if owner(uid);
        // Financial writes and status changes must use the transaction-backed callable.
        allow create, update, delete: if false;

        match /entries/{entryId} {
          allow read: if owner(uid);
          allow write: if false;
        }
      }

      match /ledgerEntries/{entryId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /operationCommands/{requestId} { allow read, write: if false; }
      match /operationProjectionReceipts/{receiptId} { allow read, write: if false; }

      // Budgets and items are written atomically by the authenticated callable.
      match /budgets/{budgetId} {
        allow read: if owner(uid);
        allow write: if false;
        match /items/{itemId} {
          allow read: if owner(uid);
          allow write: if false;
        }
      }

      // Server-only command receipts: digest + result + createdAt.
      match /budgetCommands/{requestId} {
        allow read, write: if false;
      }
      match /debtCommands/{requestId} { allow read, write: if false; }
      match /debtReversals/{requestId} { allow read: if owner(uid); allow write: if false; }
      match /debtRefunds/{operationId} { allow read: if owner(uid); allow write: if false; }

      match /monthlySummaries/{summaryId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      // Immutable audit records are written only by adjustAccountBalances.
      match /balanceAdjustments/{requestId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /{document=**} { allow read, write: if false; }
    }
  }
}
