rules_version = '2';

// Prototype production rules for the canonical mobile model. Review before
// deploying to a live Firebase project.
// Collections: categoryCatalog, users/{uid}/accounts, categories, operations,
// operations/{operationId}/entries, ledgerEntries, budgets/items and
// monthlySummaries.

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function owner(uid) { return authenticated() && request.auth.uid == uid; }
    function validCurrency(value) {
      return value is string && value.matches('^[A-Z]{3}$');
    }
    function validMonthKey(value) {
      return value is string && value.matches('^\\d{4}-(0[1-9]|1[0-2])$');
    }
    function validIdempotencyKey(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{8,128}$');
    }
    function maxMinorUnits(currency) {
      return currency == 'COP' ? 1000000000 : 100000000000;
    }
    function validMoney(value, currency) {
      return value is int && value > 0 && value <= maxMinorUnits(currency);
    }
    function validNonNegativeMoney(value, currency) {
      return value is int && value >= 0 && value <= maxMinorUnits(currency);
    }
    function required(data, fields) { return data.keys().hasAll(fields); }
    function accountExists(uid, accountId, currency) {
      return accountId is string &&
        exists(/databases/$(database)/documents/users/$(uid)/accounts/$(accountId)) &&
        get(/databases/$(database)/documents/users/$(uid)/accounts/$(accountId)).data.currency == currency;
    }
    function categoryExists(uid, categoryId, type) {
      return categoryId is string &&
        exists(/databases/$(database)/documents/users/$(uid)/categories/$(categoryId)) &&
        get(/databases/$(database)/documents/users/$(uid)/categories/$(categoryId)).data.type == type;
    }
    function validBudgetItemLink(uid, data) {
      return (!('budgetId' in data) && !('budgetItemId' in data)) ||
        (('budgetId' in data) && ('budgetItemId' in data) &&
          data.budgetId is string && data.budgetId.size() > 0 &&
          data.budgetItemId is string && data.budgetItemId.size() > 0 &&
          data.type in ['income', 'expense'] && data.categoryId is string &&
          exists(/databases/$(database)/documents/users/$(uid)/budgets/$(data.budgetId)) &&
          exists(/databases/$(database)/documents/users/$(uid)/budgets/$(data.budgetId)/items/$(data.budgetItemId)) &&
          get(/databases/$(database)/documents/users/$(uid)/budgets/$(data.budgetId)).data.categoryId == data.categoryId &&
          get(/databases/$(database)/documents/users/$(uid)/budgets/$(data.budgetId)).data.flowType == data.type &&
          get(/databases/$(database)/documents/users/$(uid)/budgets/$(data.budgetId)).data.currency == data.currency);
    }
    function validOperation(data) {
      return required(data, ['type', 'amountMinor', 'currency', 'monthKey', 'occurredAt', 'description', 'status', 'idempotencyKey', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'type', 'amountMinor', 'currency', 'categoryId', 'accountId',
          'sourceAccountId', 'destinationAccountId', 'budgetId', 'budgetItemId', 'monthKey', 'occurredAt',
          'description', 'status', 'idempotencyKey', 'createdAt', 'updatedAt'
        ]) &&
        data.type in ['income', 'expense', 'transfer'] &&
        validCurrency(data.currency) && validMoney(data.amountMinor, data.currency) &&
        validMonthKey(data.monthKey) && data.occurredAt is timestamp &&
        data.description is string && data.description.size() <= 500 &&
        data.status == 'confirmed' && validIdempotencyKey(data.idempotencyKey);
    }
    function validCategoryColor(data) {
      return !('colorValue' in data) ||
        (data.colorValue is int && data.colorValue >= 0 && data.colorValue <= 4294967295);
    }

    match /categoryCatalog/{categoryId} {
      allow read: if authenticated();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly([
        'locale', 'countryCode', 'timeZone', 'defaultCurrency',
        'onboardingStatus', 'categoryCatalogVersion', 'createdAt', 'updatedAt'
      ]) && required(request.resource.data, ['locale', 'countryCode', 'timeZone', 'defaultCurrency', 'onboardingStatus', 'categoryCatalogVersion', 'createdAt', 'updatedAt']);
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'locale', 'countryCode', 'timeZone', 'defaultCurrency',
        'onboardingStatus', 'categoryCatalogVersion', 'updatedAt'
      ]);
      allow delete: if false;

      match /accounts/{accountId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.data.keys().hasOnly([
          'name', 'type', 'currency', 'openingBalanceMinor', 'currentBalanceMinor',
          'includeInDashboard', 'status', 'createdAt', 'updatedAt', 'archivedAt'
        ]) && required(request.resource.data, ['name', 'type', 'currency', 'openingBalanceMinor', 'currentBalanceMinor', 'includeInDashboard', 'status', 'createdAt', 'updatedAt']) &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          validCurrency(request.resource.data.currency) &&
          request.resource.data.openingBalanceMinor is int &&
          request.resource.data.currentBalanceMinor is int &&
          validNonNegativeMoney(request.resource.data.openingBalanceMinor, request.resource.data.currency) &&
          validNonNegativeMoney(request.resource.data.currentBalanceMinor, request.resource.data.currency) &&
          request.resource.data.currentBalanceMinor == request.resource.data.openingBalanceMinor &&
          request.resource.data.status in ['active', 'archived'];
        allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'includeInDashboard', 'status', 'updatedAt', 'archivedAt'
        ]);
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.data.keys().hasOnly([
          'catalogId', 'type', 'name', 'icon', 'colorValue', 'sortOrder',
          'isSystem', 'isArchived', 'createdAt', 'updatedAt'
        ]) && required(request.resource.data, ['type', 'name', 'icon', 'sortOrder', 'isSystem', 'isArchived', 'createdAt', 'updatedAt']) && request.resource.data.type in ['income', 'expense'] &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          validCategoryColor(request.resource.data) &&
          (!request.resource.data.isSystem ||
            exists(/databases/$(database)/documents/categoryCatalog/$(request.resource.data.catalogId)));
        allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'icon', 'colorValue', 'sortOrder', 'isArchived', 'updatedAt'
        ]) && validCategoryColor(request.resource.data);
        allow delete: if false;
      }

      match /operations/{operationId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.id == request.resource.data.idempotencyKey &&
          validOperation(request.resource.data) &&
          (request.resource.data.type == 'transfer'
            ? accountExists(uid, request.resource.data.sourceAccountId, request.resource.data.currency) &&
              accountExists(uid, request.resource.data.destinationAccountId, request.resource.data.currency) &&
              request.resource.data.sourceAccountId != request.resource.data.destinationAccountId
            : accountExists(uid, request.resource.data.accountId, request.resource.data.currency) &&
              categoryExists(uid, request.resource.data.categoryId, request.resource.data.type)) &&
          validBudgetItemLink(uid, request.resource.data);
        allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ]) && request.resource.data.status in ['confirmed', 'rejected'];
        allow delete: if false;

        match /entries/{entryId} {
          allow read: if owner(uid);
          allow create: if owner(uid) && request.resource.data.keys().hasOnly([
            'operationId', 'accountId', 'deltaMinor', 'currency', 'occurredAt'
          ]) && request.resource.data.operationId == operationId &&
            getAfter(/databases/$(database)/documents/users/$(uid)/operations/$(operationId)).data.status == 'confirmed' &&
            request.resource.data.accountId is string && request.resource.data.deltaMinor is int &&
            validCurrency(request.resource.data.currency) && request.resource.data.occurredAt is timestamp &&
            accountExists(uid, request.resource.data.accountId, request.resource.data.currency);
          allow update, delete: if false;
        }
      }

      match /ledgerEntries/{entryId} {
        allow read: if owner(uid);
        allow create: if owner(uid) &&
          request.resource.data.keys().hasOnly([
            'operationId', 'accountId', 'deltaMinor', 'currency', 'occurredAt'
          ]) && request.resource.data.operationId is string &&
          request.resource.data.accountId is string && request.resource.data.deltaMinor is int &&
          validCurrency(request.resource.data.currency) && request.resource.data.occurredAt is timestamp &&
          accountExists(uid, request.resource.data.accountId, request.resource.data.currency) &&
          getAfter(/databases/$(database)/documents/users/$(uid)/operations/$(request.resource.data.operationId)).data.status == 'confirmed';
        allow update, delete: if false;
      }

      // Budgets and items are written atomically by the authenticated callable.
      match /budgets/{budgetId} {
        allow read: if owner(uid);
        allow write: if false;
        match /items/{itemId} {
          allow read: if owner(uid);
          allow write: if false;
        }
      }

      // Server-only command receipts: digest + result + createdAt.
      match /budgetCommands/{requestId} {
        allow read, write: if false;
      }

      match /monthlySummaries/{summaryId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      // Immutable audit records are written only by adjustAccountBalances.
      match /balanceAdjustments/{requestId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /{document=**} { allow read, write: if false; }
    }
  }
}
