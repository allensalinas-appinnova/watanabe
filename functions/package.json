{
  "name": "clearbudget-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint --ext .ts src",
    "seed:catalog": "npm run build && node lib/seed_category_catalog.js",
    "seed:catalog:real": "npm run build && node lib/seed_category_catalog_real.js",
    "test:rules": "node test/firestore_rules_test.mjs",
    "test:email-imports": "npm run build && node --test test/bank_email_parser_test.mjs test/email_imports_test.mjs",
    "test:projections": "npm run build && node --test test/projection_test.mjs",
    "audit:projections": "npm run build && node lib/audit_projections.js",
    "test:projections:emulator": "node --test test/projection_store_test.mjs test/projection_audit_test.mjs",
    "test:projections:trigger": "node --test test/projection_trigger_test.mjs",
    "test:balance-adjustments": "npm run build && node --test test/balance_adjustments_test.mjs",
    "test:balance-adjustments:callable": "node --test test/balance_adjustment_callable_test.mjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "htmlparser2": "10.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
