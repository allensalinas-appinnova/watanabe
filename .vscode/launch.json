        "--dart-define=USE_FIREBASE_EMULATORS=false",
        "--dart-define-from-file=config/firebase.dev.android.json"
      ]
    },
    {
      "name": "LumioMoney · Firebase staging (iOS)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define=APP_ENV=staging",
        "--dart-define=USE_FIREBASE_EMULATORS=false",
        "--dart-define-from-file=config/firebase.staging.ios.json"
      ]
    },
    {
