rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticatedOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isOwner(userId) {
      return isAuthenticatedOwner(userId) && !firestore.exists(/databases/(default)/documents/accountDeletions/$(userId));
    }

    // Server-reserved immutable temporary objects. Permanent reads/deletes are mediated and metered.
    match /users/{userId}/documentImports/{generation}/{importId}/source {
      function proposal() {
        return firestore.get(/databases/(default)/documents/users/$(userId)/documentImports/$(importId)).data;
      }
      function profile() {
        return firestore.get(/databases/(default)/documents/users/$(userId)).data;
      }
      // Only two Firestore documents may be read per Storage evaluation.
      // Deletion atomically blocks this profile and advances its generation;
      // missing profiles after cleanup fail closed as well.
      allow create: if resource == null && isAuthenticatedOwner(userId) && request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        profile().get('resetStatus', 'ready') == 'ready' && proposal().dataGeneration == profile().get('dataGeneration', 0) &&
        generation == string(proposal().dataGeneration) && proposal().status == 'prepared' &&
        proposal().expiresAt > request.time && request.resource.size == proposal().size &&
        request.resource.size <= 10000000 && request.resource.contentType == proposal().contentType &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
      allow read, update, delete: if false;
    }
    match /users/{userId}/receipts/{fileName} {
      allow read, delete: if isOwner(userId);
      // Legacy paths cannot bypass server reservations and per-user quotas.
      allow create, update: if false;
    }
  }
}
